{
  "expo": {
    "name": "Linedrive",
    "slug": "linedrive",
    "scheme": "linedrive",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#07030f",
    "ios": {
      "bundleIdentifier": "com.gbymedia.linedrive",
      "supportsTablet": false,
      "infoPlist": {
        "UIStatusBarHidden": true,
        "UIViewControllerBasedStatusBarAppearance": false,
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-build-properties",
      "expo-audio",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07030f",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "Linedrive uses this to show you more relevant ads. You can still play everything if you say no."
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "delayAppMeasurementInit": true,
          "skAdNetworkItems": [
            "cstr6suwn9.skadnetwork"
          ]
        }
      ],
      "expo-asset"
    ],
    "owner": "gbymediallc",
    "extra": {
      "eas": {
        "projectId": "56077049-ce45-4e8e-93c4-93799bf85326"
      }
    }
  }
}
