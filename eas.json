{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "env": {
        "EXPO_PUBLIC_REVENUECAT_IOS_KEY": "appl_REPLACE_WITH_YOUR_REVENUECAT_IOS_KEY",
        "EXPO_PUBLIC_LEADERBOARD_URL": ""
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal"
    },
    "production": {
